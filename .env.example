# =============================================================================
# Elysia Code - Environment Configuration Example
# Copy this file to .env and configure local values as needed:
# cp .env.example .env
# =============================================================================

# Server Network Configuration
PORT=8080
HOST=127.0.0.1

# Optional AI Tutor Providers (Leave empty to use built-in Socratic curriculum)
# Google Gemini API Key
GEMINI_API_KEY=

# Groq API Key
GROQ_API_KEY=

# =============================================================================
# Database Configuration (Pluggable Dual-Engine)
# =============================================================================
# Option A: SQLite (Default - Zero setup, perfect for local development & offline use)
DB_TYPE=sqlite
# ELYSIA_DATA_DIR=./data

# Option B: MySQL / MariaDB (High Concurrency & Cloud Scaling)
# Uncomment to use MySQL (requires: pip install pymysql):
# DB_TYPE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=elysia_code

# Or supply a standard cloud connection URL (e.g. Railway, Render, Supabase, Aiven):
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/elysia_code

# Option C: Supabase / PostgreSQL (Managed Cloud Database)
# Requires driver: pip install psycopg2-binary
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

